1) Design a webpage. The page contains:
a. Dropdown list with HP, Nokia, Samsung, Motorola, Apple as items.
b. Checkbox with Mobile and Laptop as items. Textbox where you enter quantity.
c. There is a button with text as ‘Produce Bill’.
<!DOCTYPE html>
<html>
<head>
 <title>Product Billing Page</title>
 <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
 <script>
 $(document).ready(function () {
 $("#billBtn").click(function () {
 var company = $("#company").val();
 var quantity = $("#quantity").val();
 var selected = [];
 $("input[name='type']:checked").each(function () {
 selected.push($(this).val());
 });
 if (quantity === "" || selected.length === 0) {
 alert("Please select item type and enter quantity");
 return;
 }
 var output =
 "<b>Bill Details</b><br>" +
 "Brand: " + company + "<br>" +
 "Item: " + selected.join(" / ") + "<br>" +
 "Quantity: " + quantity;
 $("#resultBox").html(output).fadeIn();
 });
 });
 </script>
</head>
<body style="
 font-family: Arial;
 background:#eef1f4;
 height:100vh;
 display:flex;
 justify-content:center;
 align-items:center;
">
<div style="
 background:white;
 padding:25px;
 width:350px;
 border-radius:10px;
 box-shadow:0 6px 15px rgba(0,0,0,0.15);
">
 <h3 style="margin-top:0; text-align:center;">Produce Bill</h3>
 <label>Select Company:</label><br>
 <select id="company" style="width:100%; padding:6px;">
 <option>HP</option>
 <option>Nokia</option>
 <option>Samsung</option>
 <option>Motorola</option>
 <option>Apple</option>
 </select><br><br>
 <label>Select Product:</label><br>
 <input type="checkbox" name="type" value="Mobile"> Mobile
 <input type="checkbox" name="type" value="Laptop"> Laptop
 <br><br>
 <label>Enter Quantity:</label><br>
 <input type="number" id="quantity" min="1" style="width:100%; padding:6px;">
 <br><br>
 <button id="billBtn"
 style="
 width:100%;
 padding:10px;
 background:#28a745;
 color:white;
 border:none;
 cursor:pointer;
 ">
 Produce Bill
 </button>
 <div id="resultBox"
 style="
 margin-top:15px;
 padding:10px;
 background:#f1f8ff;
 border-left:4px solid #28a745;
 display:none;
 ">
 </div>
</div>
</body>
</html>
