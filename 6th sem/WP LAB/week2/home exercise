2) Implement the bouncing ball using animate() function.
<!DOCTYPE html>
<html>
<head>
 <title>Bouncing Ball Animation</title>
 <meta charset="UTF-8">
 <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
 <script>
 $(document).ready(function () {
 function bounceBall() {
 $("#ball").animate(
 { top: "300px" },
 600,
 "swing",
 function () {
 $("#ball").animate(
 { top: "20px" },
 600,
 "swing",
 bounceBall // recursive call for continuous bounce
 );
 }
 );
 }
 $("#startBtn").click(function () {
 bounceBall();
 $(this).prop("disabled", true).text("Bouncing...");
 });
 });
 </script>
</head>
<body style="
 margin:0;
 height:100vh;
 display:flex;
 flex-direction:column;
 align-items:center;
 justify-content:center;
 background:#eef2f7;
 font-family:Arial;
">
 <button id="startBtn"
 style="
 padding:10px 20px;
 background:#007bff;
 color:white;
 border:none;
 cursor:pointer;
 margin-bottom:30px;
 ">
 Start Bouncing
 </button>
 <div style="
 width:400px;
 height:350px;
 border:2px solid #444;
 position:relative;
 background:white;
 ">
 <div id="ball"
 style="
 width:50px;
 height:50px;
 background:red;
 border-radius:50%;
 position:absolute;
 top:20px;
 left:175px;
">
 </div>
 </div>
</body>
</html>
