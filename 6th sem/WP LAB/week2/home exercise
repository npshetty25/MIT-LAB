3.Write a web page which displays image and show the sliding text on the image.
<!DOCTYPE html>
<html>
<head>
 <title>Continuous Sliding Text</title>
 <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
 <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@700&display=swap" 
rel="stylesheet">
 <style>
 body {
 font-family: 'Roboto', sans-serif;
 display: flex;
 justify-content: center;
 align-items: center;
 min-height: 100vh;
 background-color: #f4f4f4;
 margin: 0;
 }
 .image-container {
 position: relative;
 width: 600px;
 height: 400px;
 overflow: hidden;
 border-radius: 10px;
 box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
 }
 .image-container img {
 width: 100%;
 height: 100%;
 display: block;
 object-fit: cover;
 }
 .sliding-text {
 position: absolute;
 bottom: 20px;
 left: -300px; 
 white-space: nowrap;
 background-color: rgba(0, 0, 0, 0.7);
 color: white;
 padding: 10px 20px;
 border-radius: 5px;
 font-size: 1.2em;
 }
 </style>
</head>
<body>
 <div class="image-container">
 <img src="SCENE.jpeg" alt="Landscape">
 <div class="sliding-text">
 HELLO !!!!
 </div>
 </div>
 <script type="text/javascript">
 $(document).ready(function() {
 function moveRight() {
 var containerWidth = $('.image-container').width();
 var textWidth = $('.sliding-text').outerWidth();
 $('.sliding-text').css('left', -textWidth);
 $('.sliding-text').animate({
 left: containerWidth
 }, 5000, 'linear', function() {
 moveRight();
 });
 }
 moveRight();
 });
 </script>
</body>
</html>
